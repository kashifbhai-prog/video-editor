# Copy to ".env" (or set these in your hosting dashboard) and fill in.
# Public address of the site (used for canonical links, sitemap and social cards).
VITE_SITE_URL=https://www.your-domain.com
# Shown on the Contact, Privacy and Terms pages.
VITE_CONTACT_EMAIL=support@your-domain.com
# Where the editor's Feedback dialog sends messages (a Google Apps Script web app URL).
# Empty = the dialog opens the visitor's email app addressed to VITE_CONTACT_EMAIL.
VITE_FEEDBACK_URL=
# Google Analytics 4 measurement id (Admin → Data streams). Empty = no analytics.
VITE_GA_ID=
# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Empty = no ads.
VITE_ADSENSE_CLIENT=
# Optional: an AdSense display ad unit id for the in-page ad slots (Auto ads work without it).
VITE_ADSENSE_SLOT=
